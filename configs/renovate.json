{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "automerge": false,
  "dependencyDashboard": true,
  "enabledManagers": ["cargo", "npm", "pep621"],
  "branchPrefix": "deps/",
  "labels": ["dependencies", "requires-regression"],
  "prConcurrentLimit": 2,
  "rangeStrategy": "bump"
}
