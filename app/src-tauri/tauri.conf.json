{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yigou",
  "version": "0.2.5",
  "identifier": "io.yigou.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist",
    "features": [
      "desktop"
    ]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "意构 · 网络工程桌面工作台",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "externalBin": [
      "binaries/yigou-worker"
    ],
    "category": "DeveloperTool",
    "shortDescription": "网络设备与 AI 工作台",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0t64",
          "git",
          "gnome-keyring"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../LICENSES/": "licenses/"
    }
  }
}
